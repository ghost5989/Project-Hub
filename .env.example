# Server
PORT=3000
NODE_ENV=development

# Session
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SESSION_MAX_AGE_HOURS=24

# Initial owner account (created on first boot if users.json empty)
OWNER_USERNAME=admin
OWNER_PASSWORD=admin
OWNER_EMAIL=admin@projecthub.local

# GitHub global access password (empty = public)
GITHUB_ACCESS_PASSWORD=